{
  "name": "game-balance-sim-template",
  "version": "0.1.0",
  "private": true,
  "description": "Dependency-light TypeScript harness for balancing a game with simulated players (bots) and Monte Carlo batches.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sim": "tsx src/runner.ts",
    "replay": "tsx src/replay.ts",
    "scorecard": "tsx src/scorecard.ts",
    "items": "tsx src/tools/item-strength.ts",
    "calibrate": "tsx src/tools/boss-calibrator.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
